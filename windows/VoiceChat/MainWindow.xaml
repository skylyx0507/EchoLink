<Window x:Class="VoiceChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EchoLink" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI, Microsoft YaHei">

    <Window.Resources>
        <!-- 颜色资源 -->
        <Color x:Key="PrimaryColor">#6366f1</Color>
        <Color x:Key="PrimaryHoverColor">#4f46e5</Color>
        <Color x:Key="SuccessColor">#10b981</Color>
        <Color x:Key="DangerColor">#ef4444</Color>
        <Color x:Key="BgColor">#0f172a</Color>
        <Color x:Key="BgSecondaryColor">#1e293b</Color>
        <Color x:Key="BgCardColor">#1e293b</Color>
        <Color x:Key="BgInputColor">#334155</Color>
        <Color x:Key="BgHoverColor">#475569</Color>
        <Color x:Key="TextColor">#f1f5f9</Color>
        <Color x:Key="TextSecondaryColor">#94a3b8</Color>
        <Color x:Key="TextMutedColor">#64748b</Color>
        <Color x:Key="BorderColor">#334155</Color>

        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
        <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondaryColor}"/>
        <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}"/>
        <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource BgInputColor}"/>
        <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHoverColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>

        <!-- 渐变画刷 -->
        <LinearGradientBrush x:Key="AvatarSelfBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6366f1" Offset="0"/>
            <GradientStop Color="#7c3aed" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AvatarOtherBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#10b981" Offset="0"/>
            <GradientStop Color="#059669" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AvatarMutedBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#64748b" Offset="0"/>
            <GradientStop Color="#475569" Offset="1"/>
        </LinearGradientBrush>

        <!-- 说话光环动画（双层脉冲） -->
        <Storyboard x:Key="SpeakingStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpeakingRing"
                             Storyboard.TargetProperty="Opacity"
                             From="0.4" To="0.9" Duration="0:0:0.8"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SpeakingRing"
                             Storyboard.TargetProperty="(ScaleTransform.ScaleX)"
                             From="1" To="1.12" Duration="0:0:0.8"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SpeakingRing"
                             Storyboard.TargetProperty="(ScaleTransform.ScaleY)"
                             From="1" To="1.12" Duration="0:0:0.8"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 说话外环动画 -->
        <Storyboard x:Key="SpeakingOuterRingStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpeakingOuterRing"
                             Storyboard.TargetProperty="Opacity"
                             From="0.2" To="0.5" Duration="0:0:1.2"
                             AutoReverse="True" BeginTime="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SpeakingOuterRing"
                             Storyboard.TargetProperty="(ScaleTransform.ScaleX)"
                             From="1" To="1.2" Duration="0:0:1.2"
                             AutoReverse="True" BeginTime="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SpeakingOuterRing"
                             Storyboard.TargetProperty="(ScaleTransform.ScaleY)"
                             From="1" To="1.2" Duration="0:0:1.2"
                             AutoReverse="True" BeginTime="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 圆形按钮样式 -->
        <Style x:Key="CircleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="PART_Background" Fill="{StaticResource BgInputBrush}"
                                     Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PART_Background" Property="Fill" Value="{StaticResource BgHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PART_Background" Property="Fill" Value="{StaticResource BgHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 降噪按钮样式 -->
        <Style x:Key="NoiseButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉框样式 -->
        <Style x:Key="DeviceComboStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <!-- ToggleButton 覆盖整个区域接收点击 -->
                                    <ToggleButton x:Name="DropDownToggle" 
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Grid>
                                                        <ContentPresenter x:Name="ToggleContent" 
                                                                          Content="{TemplateBinding Content}"
                                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                          HorizontalAlignment="Left"
                                                                          VerticalAlignment="Center"
                                                                          Margin="4,0,20,0"/>
                                                        <Path x:Name="Arrow" 
                                                              Fill="{StaticResource TextMutedBrush}" 
                                                              HorizontalAlignment="Right" 
                                                              VerticalAlignment="Center" 
                                                              Margin="0,0,4,0"
                                                              Data="M 0 0 L 4 4 L 8 0 Z"/>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <!-- 显示当前选中项 -->
                                    <ContentPresenter IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}" 
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                                      Margin="4,2,20,2" 
                                                      VerticalAlignment="Center" 
                                                      HorizontalAlignment="Left"/>
                                </Grid>
                            </Border>
                            <Popup x:Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown" 
                                      SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" 
                                            Background="{StaticResource BgCardBrush}" 
                                            BorderBrush="{StaticResource BorderBrush}" 
                                            BorderThickness="1" 
                                            CornerRadius="8"
                                            Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" Opacity="0.4" ShadowDepth="4" Color="Black"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="4,6" SnapsToDevicePixels="True">
                                            <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Border" 
                                            Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                            Padding="{TemplateBinding Padding}" 
                                            CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 断开按钮样式 -->
        <Style x:Key="DisconnectButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#3d1516"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource SpeakingStoryboard}"/>
            <BeginStoryboard Storyboard="{StaticResource SpeakingOuterRingStoryboard}"/>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 频道头部 -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,12">
            <DockPanel>
                <!-- 频道信息 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <!-- 麦克风图标 -->
                    <Viewbox Width="24" Height="24" Margin="0,0,12,0">
                        <Canvas Width="24" Height="24">
                            <Path Fill="{StaticResource TextMutedBrush}"
                                  Data="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                            <Path Fill="Transparent" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="2"
                                  Data="M19 10v2a7 7 0 0 1-14 0v-2"/>
                            <Line X1="12" Y1="19" X2="12" Y2="23" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="2"/>
                            <Line X1="8" Y1="23" X2="16" Y2="23" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="2"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="RoomNameText" FontSize="17" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="语音频道" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 右侧操作 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <!-- 音频设备选择 -->
                    <Border Background="{StaticResource BgInputBrush}" CornerRadius="8" Padding="6,4" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <!-- 麦克风设备 -->
                            <Viewbox Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{StaticResource TextMutedBrush}"
                                          Data="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                                    <Path Fill="Transparent" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="2"
                                          Data="M19 10v2a7 7 0 0 1-14 0v-2"/>
                                </Canvas>
                            </Viewbox>
                            <ComboBox x:Name="MicDeviceCombo" Width="140" FontSize="11"
                                      Style="{StaticResource DeviceComboStyle}"
                                      VerticalAlignment="Center"
                                      SelectionChanged="MicDeviceCombo_Changed"
                                      DisplayMemberPath="ProductName"/>

                            <!-- 分隔线 -->
                            <Rectangle Width="1" Height="16" Fill="{StaticResource BorderBrush}"
                                       Margin="6,0" VerticalAlignment="Center"/>

                            <!-- 扬声器设备 -->
                            <Viewbox Width="14" Height="14" Margin="0,0,4,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{StaticResource TextMutedBrush}"
                                          Data="M11 5L6 9H2v6h4l5 4V5zM19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/>
                                </Canvas>
                            </Viewbox>
                            <ComboBox x:Name="SpeakerDeviceCombo" Width="140" FontSize="11"
                                      Style="{StaticResource DeviceComboStyle}"
                                      VerticalAlignment="Center"
                                      SelectionChanged="SpeakerDeviceCombo_Changed"
                                      DisplayMemberPath="ProductName"/>
                        </StackPanel>
                    </Border>

                    <!-- 降噪控制 -->
                    <Border Background="{StaticResource BgInputBrush}" CornerRadius="8" Padding="4,2" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="关闭" GroupName="Noise" Style="{StaticResource NoiseButtonStyle}"
                                         IsChecked="True" Click="NoiseLevel_Click" Tag="off"/>
                            <RadioButton Content="低" GroupName="Noise" Style="{StaticResource NoiseButtonStyle}"
                                         Click="NoiseLevel_Click" Tag="low"/>
                            <RadioButton Content="中" GroupName="Noise" Style="{StaticResource NoiseButtonStyle}"
                                         Click="NoiseLevel_Click" Tag="medium"/>
                            <RadioButton Content="高" GroupName="Noise" Style="{StaticResource NoiseButtonStyle}"
                                         Click="NoiseLevel_Click" Tag="high"/>
                        </StackPanel>
                    </Border>

                    <!-- 断开按钮 -->
                    <Button Style="{StaticResource DisconnectButtonStyle}" Click="LeaveBtn_Click" ToolTip="断开连接">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{StaticResource DangerBrush}"
                                          Data="M10.68 13.31a16 16 0 0 0 3.41 2.6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7 2 2 0 0 1 1.72 2v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91"/>
                                    <Line X1="1" Y1="1" X2="23" Y2="23" Stroke="{StaticResource DangerBrush}" StrokeThickness="2"/>
                                </Canvas>
                            </Viewbox>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 成员列表 -->
        <ScrollViewer Grid.Row="1" Background="{StaticResource BgCardBrush}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="24">
            <WrapPanel x:Name="MembersPanel">
                <!-- 自己的卡片 - 在代码中动态创建 -->
            </WrapPanel>
        </ScrollViewer>

        <!-- 底部控制栏 -->
        <Border Grid.Row="2" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：用户信息 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="40" Height="40" Margin="0,0,12,0">
                        <Ellipse x:Name="ControlAvatar" Fill="{StaticResource AvatarSelfBrush}"/>
                        <Ellipse x:Name="SpeakingRing" Opacity="0" Stroke="{StaticResource SuccessBrush}"
                                 StrokeThickness="2.5" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="SpeakingOuterRing" Opacity="0" Stroke="{StaticResource SuccessBrush}"
                                 StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ControlUserName" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="ControlUserState" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                                   Text="麦克风已关" Opacity="0.8"/>
                    </StackPanel>
                </StackPanel>

                <!-- 中间：控制按钮 -->
                <Button Grid.Column="1" x:Name="MicBtn" Style="{StaticResource CircleButtonStyle}"
                        Click="MicBtn_Click" ToolTip="开启麦克风" Margin="20,0">
                    <Viewbox Width="24" Height="24">
                        <Canvas Width="24" Height="24">
                            <Path Fill="{StaticResource TextBrush}"
                                  Data="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                            <Path Fill="Transparent" Stroke="{StaticResource TextBrush}" StrokeThickness="2"
                                  Data="M19 10v2a7 7 0 0 1-14 0v-2"/>
                            <Line X1="12" Y1="19" X2="12" Y2="23"
                                  Stroke="{StaticResource TextBrush}" StrokeThickness="2"/>
                            <Line X1="8" Y1="23" X2="16" Y2="23"
                                  Stroke="{StaticResource TextBrush}" StrokeThickness="2"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- 右侧：在线人数 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBlock FontSize="14" Foreground="{StaticResource TextMutedBrush}">
                        <Run x:Name="OnlineCountRun" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <Run Text=" 在线"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
