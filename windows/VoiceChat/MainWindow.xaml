<Window x:Class="VoiceChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EchoLink" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1e1f22"
        Foreground="#f2f3f5"
        FontFamily="Segoe UI, Microsoft YaHei">

    <Window.Resources>
        <!-- 颜色资源 -->
        <Color x:Key="PrimaryColor">#5865f2</Color>
        <Color x:Key="PrimaryHoverColor">#4752c4</Color>
        <Color x:Key="SuccessColor">#23a559</Color>
        <Color x:Key="DangerColor">#f23f43</Color>
        <Color x:Key="BgColor">#1e1f22</Color>
        <Color x:Key="BgSecondaryColor">#2b2d31</Color>
        <Color x:Key="BgCardColor">#313338</Color>
        <Color x:Key="BgInputColor">#383a40</Color>
        <Color x:Key="BgHoverColor">#404249</Color>
        <Color x:Key="TextColor">#f2f3f5</Color>
        <Color x:Key="TextSecondaryColor">#b5bac1</Color>
        <Color x:Key="TextMutedColor">#949ba4</Color>
        <Color x:Key="BorderColor">#3f4147</Color>

        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
        <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondaryColor}"/>
        <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}"/>
        <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource BgInputColor}"/>
        <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHoverColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>

        <!-- 渐变画刷 -->
        <LinearGradientBrush x:Key="AvatarSelfBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5865f2" Offset="0"/>
            <GradientStop Color="#7c3aed" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AvatarOtherBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#23a559" Offset="0"/>
            <GradientStop Color="#059669" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AvatarMutedBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#949ba4" Offset="0"/>
            <GradientStop Color="#6b7280" Offset="1"/>
        </LinearGradientBrush>

        <!-- 说话动画 -->
        <Storyboard x:Key="SpeakingStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpeakingRing"
                             Storyboard.TargetProperty="Opacity"
                             From="0.3" To="1" Duration="0:0:0.6"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SpeakingRing"
                             Storyboard.TargetProperty="(ScaleTransform.ScaleX)"
                             From="1" To="1.15" Duration="0:0:0.6"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="SpeakingRing"
                             Storyboard.TargetProperty="(ScaleTransform.ScaleY)"
                             From="1" To="1.15" Duration="0:0:0.6"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 音波动画条 -->
        <Storyboard x:Key="WaveBar1" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="WaveBar1"
                             Storyboard.TargetProperty="Height"
                             From="4" To="16" Duration="0:0:0.3"
                             AutoReverse="True">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="WaveBar2" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="WaveBar2"
                             Storyboard.TargetProperty="Height"
                             From="4" To="20" Duration="0:0:0.35"
                             AutoReverse="True" BeginTime="0:0:0.1">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="WaveBar3" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="WaveBar3"
                             Storyboard.TargetProperty="Height"
                             From="4" To="14" Duration="0:0:0.25"
                             AutoReverse="True" BeginTime="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- 登录按钮样式 -->
        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="0,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 输入框样式 -->
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource BgInputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 圆形按钮样式 -->
        <Style x:Key="CircleButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="bg" Fill="{StaticResource BgInputBrush}"
                                     Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Fill" Value="{StaticResource BgHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 小按钮样式（头部操作按钮） -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 降噪按钮样式 -->
        <Style x:Key="NoiseButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="Transparent"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 断开按钮样式 -->
        <Style x:Key="DisconnectButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#3d1516"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource SpeakingStoryboard}"/>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
    <!-- ========== 登录界面 ========== -->
    <Grid x:Name="LoginPanel" Background="{StaticResource BgBrush}">
        <Border x:Name="LoginCard" Background="{StaticResource BgCardBrush}" CornerRadius="12"
                Width="420" Padding="32"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="4" Color="Black"/>
            </Border.Effect>
            <StackPanel>
                <!-- Logo -->
                <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource PrimaryBrush}"
                        HorizontalAlignment="Center" Margin="0,0,0,20">
                    <TextBlock Text="E" FontSize="28" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- 标题 -->
                <TextBlock Text="EchoLink" FontSize="26" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="游戏语音，低延迟沟通" FontSize="13"
                           HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"
                           Margin="0,4,0,28"/>

                <!-- 输入区域 -->
                <TextBlock Text="服务器地址" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="ServerInput" Text="ws://localhost:3000"
                         Style="{StaticResource InputStyle}" Margin="0,0,0,16"/>

                <TextBlock Text="房间号" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="RoomInput" Text="test-room"
                         Style="{StaticResource InputStyle}" Margin="0,0,0,16"/>

                <TextBlock Text="昵称" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="PeerInput" Text=""
                         Style="{StaticResource InputStyle}" Margin="0,0,0,20"/>

                <!-- 错误提示 -->
                <Border x:Name="ErrorBorder" Background="#3d1516" CornerRadius="8" Padding="12"
                        Margin="0,0,0,16" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorText" Foreground="#fca5a5" FontSize="13" TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </Border>

                <!-- 加入按钮 -->
                <Button x:Name="JoinBtn" Content="进入语音房间"
                        Style="{StaticResource LoginButtonStyle}" Click="JoinBtn_Click"/>
            </StackPanel>
        </Border>
    </Grid>

    <!-- ========== 房间界面 ========== -->
    <Grid x:Name="RoomPanel" Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 频道头部 -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel>
                <!-- 频道信息 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <!-- 麦克风图标 -->
                    <Viewbox Width="22" Height="22" Margin="0,0,12,0">
                        <Canvas Width="24" Height="24">
                            <Path Fill="{StaticResource TextMutedBrush}"
                                  Data="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                            <Path Fill="Transparent" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="2"
                                  Data="M19 10v2a7 7 0 0 1-14 0v-2"/>
                            <Line X1="12" Y1="19" X2="12" Y2="23" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="2"/>
                            <Line X1="8" Y1="23" X2="16" Y2="23" Stroke="{StaticResource TextMutedBrush}" StrokeThickness="2"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="RoomNameText" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="语音频道" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 右侧操作 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <!-- 降噪控制 -->
                    <Border Background="{StaticResource BgInputBrush}" CornerRadius="8" Padding="4,2" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="关闭" GroupName="Noise" Style="{StaticResource NoiseButtonStyle}"
                                         IsChecked="True" Click="NoiseLevel_Click" Tag="off"/>
                            <RadioButton Content="低" GroupName="Noise" Style="{StaticResource NoiseButtonStyle}"
                                         Click="NoiseLevel_Click" Tag="low"/>
                            <RadioButton Content="中" GroupName="Noise" Style="{StaticResource NoiseButtonStyle}"
                                         Click="NoiseLevel_Click" Tag="medium"/>
                            <RadioButton Content="高" GroupName="Noise" Style="{StaticResource NoiseButtonStyle}"
                                         Click="NoiseLevel_Click" Tag="high"/>
                        </StackPanel>
                    </Border>

                    <!-- 断开按钮 -->
                    <Button Style="{StaticResource DisconnectButtonStyle}" Click="LeaveBtn_Click" ToolTip="断开连接">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="18" Height="18">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{StaticResource DangerBrush}"
                                          Data="M10.68 13.31a16 16 0 0 0 3.41 2.6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7 2 2 0 0 1 1.72 2v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91"/>
                                    <Line X1="1" Y1="1" X2="23" Y2="23" Stroke="{StaticResource DangerBrush}" StrokeThickness="2"/>
                                </Canvas>
                            </Viewbox>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 成员列表 -->
        <ScrollViewer Grid.Row="1" Background="{StaticResource BgCardBrush}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="20">
            <WrapPanel x:Name="MembersPanel">
                <!-- 自己的卡片 - 在代码中动态创建 -->
            </WrapPanel>
        </ScrollViewer>

        <!-- 底部控制栏 -->
        <Border Grid.Row="2" Background="{StaticResource BgSecondaryBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <!-- 左侧：用户信息 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <!-- 头像 -->
                    <Grid Width="36" Height="36" Margin="0,0,10,0">
                        <Ellipse x:Name="ControlAvatar" Fill="{StaticResource AvatarSelfBrush}"/>
                        <!-- 说话光环 -->
                        <Ellipse x:Name="SpeakingRing" Opacity="0" Stroke="{StaticResource SuccessBrush}"
                                 StrokeThickness="2.5" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ControlUserName" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="ControlUserState" FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                   Text="麦克风已关"/>
                    </StackPanel>
                </StackPanel>

                <!-- 中间：控制按钮 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- 麦克风按钮 -->
                    <Button x:Name="MicBtn" Style="{StaticResource CircleButtonStyle}"
                            Click="MicBtn_Click" ToolTip="开启麦克风">
                        <Viewbox Width="22" Height="22">
                            <Canvas x:Name="MicIcon" Width="24" Height="24">
                                <Path x:Name="MicIconPath" Fill="{StaticResource TextBrush}"
                                      Data="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                                <Path x:Name="MicIconPath2" Fill="Transparent" Stroke="{StaticResource TextBrush}" StrokeThickness="2"
                                      Data="M19 10v2a7 7 0 0 1-14 0v-2"/>
                                <Line x:Name="MicIconLine1" X1="12" Y1="19" X2="12" Y2="23"
                                      Stroke="{StaticResource TextBrush}" StrokeThickness="2"/>
                                <Line x:Name="MicIconLine2" X1="8" Y1="23" X2="16" Y2="23"
                                      Stroke="{StaticResource TextBrush}" StrokeThickness="2"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>

                <!-- 右侧：延迟和在线人数 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Border x:Name="LatencyBorder" Background="{StaticResource BgInputBrush}" CornerRadius="12"
                            Padding="8,4" Margin="0,0,12,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="14" Margin="0,0,4,0">
                                <Canvas Width="24" Height="24">
                                    <Ellipse Width="20" Height="20" Canvas.Left="2" Canvas.Top="2"
                                             Stroke="{StaticResource SuccessBrush}" StrokeThickness="2" Fill="Transparent"/>
                                    <Line X1="12" Y1="6" X2="12" Y2="12" Stroke="{StaticResource SuccessBrush}" StrokeThickness="2"/>
                                    <Line X1="12" Y1="12" X2="16" Y2="14" Stroke="{StaticResource SuccessBrush}" StrokeThickness="2"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="LatencyText" FontSize="12" FontWeight="Medium"
                                       Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock FontSize="13" Foreground="{StaticResource TextMutedBrush}">
                        <Run x:Name="OnlineCountRun" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <Run Text=" 在线"/>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
    </Grid>
</Window>
