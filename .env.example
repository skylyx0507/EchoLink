# EchoLink 环境变量配置

# 服务器公网 IP（必填，用于 WebRTC ICE candidate）
# 本地开发使用 127.0.0.1
# 部署时改为实际公网 IP
ANNOUNCED_IP=127.0.0.1

# 服务器端口（可选，默认 1985）
LISTEN_PORT=3000

# WebRTC UDP 端口范围（可选，默认 10000-10100）
RTC_MIN_PORT=10000
RTC_MAX_PORT=10100

# 认证密钥（可选，设置后启用用户注册/登录和 Token 认证）
# 不设置则无需认证（向后兼容）
AUTH_SECRET=

# 管理密钥（可选，保护 /token 接口）
# 设置后 POST /token 需要 Authorization: Bearer <key>
AUTH_ADMIN_KEY=

# 数据库路径（可选，默认 server/data/echolink.db）
DB_PATH=
