# EchoLink 环境变量配置

# 服务器公网 IP（必填，用于 WebRTC ICE candidate）
# 本地开发使用 127.0.0.1
# 部署时改为实际公网 IP
ANNOUNCED_IP=127.0.0.1

# 服务器端口（可选，默认 3000）
LISTEN_PORT=3000

# WebRTC UDP 端口范围（可选，默认 10000-10100）
RTC_MIN_PORT=10000
RTC_MAX_PORT=10100

# JWT 认证配置
# JWT_SECRET 用于签发和验证登录 token，部署时必须设置为强随机字符串
# 本地开发可保持默认值，但生产环境务必修改
JWT_SECRET=change-me-in-production

# JWT token 有效期（可选，默认 7d）
JWT_EXPIRES_IN=7d

# SQLite 数据库文件路径（可选，默认 server/echolink.db）
# 使用绝对路径可避免工作目录变化导致的数据库位置不一致
DATABASE_PATH=./echolink.db
